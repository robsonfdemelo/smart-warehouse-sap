<mvc:View
    controllerName="smartwarehouse.ui.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    height="100%">
    <Page
        title="Smart Warehouse SAP"
        enableScrolling="true">
        <content>
            <VBox class="sapUiMediumMargin" renderType="Bare">
                <Title
                    text="Gestão de Estoque"
                    level="H2"
                    class="sapUiSmallMarginBottom"/>
                <Text
                    text="Visão geral e movimentações de materiais."
                    class="sapUiMediumMarginBottom"/>
                <HBox
                    wrap="Wrap"
                    renderType="Bare"
                    class="sapUiMediumMarginBottom">
                    <VBox
                        width="15rem"
                        class="smartDashboardCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://product" size="1.5rem" class="sapUiTinyMarginBottom"/>
                        <Title text="Produtos distintos" level="H4"/>
                        <ObjectNumber
                            number="{dashboard>/totalProducts}"
                            emphasized="true"/>
                        <Text text="Materiais no estoque"/>
                    </VBox>
                    <VBox
                        width="15rem"
                        class="smartDashboardCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://factory" size="1.5rem" class="sapUiTinyMarginBottom"/>
                        <Title text="Depósitos com saldo" level="H4"/>
                        <ObjectNumber
                            number="{dashboard>/totalLocations}"
                            emphasized="true"/>
                        <Text text="Locais com estoque positivo"/>
                    </VBox>
                    <VBox
                        width="15rem"
                        class="smartDashboardCard sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://inventory" size="1.5rem" class="sapUiTinyMarginBottom"/>
                        <Title text="Unidades em estoque" level="H4"/>
                        <ObjectNumber
                            number="{dashboard>/totalQuantity}"
                            emphasized="true"/>
                        <Text text="Saldo total disponível"/>
                    </VBox>
                </HBox>
                <Toolbar class="sapUiMediumMarginBottom">
                    <Title text="Módulos" level="H3"/>
                    <ToolbarSpacer/>
                    <Button text="Cadastro de produtos" icon="sap-icon://product" type="Emphasized" press=".onOpenProducts"/>
                </Toolbar>
                <Toolbar class="sapUiMediumMarginBottom">
                    <Title text="Movimentações" level="H3"/>
                    <ToolbarSpacer/>
                    <Button
                        text="Entrada"
                        icon="sap-icon://add"
                        type="Accept"
                        press=".onOpenEntry"/>
                    <Button
                        text="Saída"
                        icon="sap-icon://less"
                        type="Reject"
                        press=".onOpenExit"/>
                    <Button
                        text="Transferência"
                        icon="sap-icon://synchronize"
                        press=".onOpenTransfer"/>
                </Toolbar>
                <Toolbar>
                    <Title text="Estoque disponível" level="H3"/>
                    <ToolbarSpacer/>
                    <Button
                        text="Atualizar"
                        icon="sap-icon://refresh"
                        type="Emphasized"
                        enabled="{= !${dashboard>/loading} }"
                        press=".onRefresh"/>
                </Toolbar>
<Table
    id="stockTable"
    width="100%"
    growing="true"
    growingThreshold="20"
    noDataText="Nenhum registro de estoque encontrado."
    items="{
        path: '/Stock',
        parameters: {
            $expand: 'product,storageLocation'
        }
    }">
    <columns>
        <Column><Text text="Produto"/></Column>
        <Column><Text text="Descrição"/></Column>
        <Column><Text text="Depósito"/></Column>
        <Column hAlign="End"><Text text="Quantidade"/></Column>
    </columns>
    <items>
        <ColumnListItem>
            <cells>
                <Text text="{product/code}"/>
                <Text text="{product/name}"/>
                <Text text="{storageLocation/code}"/>
                <ObjectNumber number="{quantity}"/>
            </cells>
        </ColumnListItem>
    </items>
</Table>
<Toolbar class="sapUiMediumMarginTop">
    <Title
        text="Histórico de movimentações"
        level="H3"/>
    <ToolbarSpacer/>
    <Button
        text="Atualizar histórico"
        icon="sap-icon://refresh"
        press=".onRefreshHistory"/>
</Toolbar>
        <Table
            id="movementsTable"
            width="100%"
            growing="true"
            growingThreshold="20"
            noDataText="Nenhuma movimentação encontrada."
            items="{
                path: '/StockMovements',
                parameters: {
                    $expand: 'product,sourceLocation,destinationLocation',
                    $orderby: 'createdAt desc'
                }
            }">
            <columns>
                <Column>
                    <Text text="Data"/>
                </Column>
                <Column>
                    <Text text="Tipo"/>
                </Column>
                <Column>
                    <Text text="Produto"/>
                </Column>
                <Column>
                    <Text text="Origem"/>
                </Column>
                <Column>
                    <Text text="Destino"/>
                </Column>
                <Column hAlign="End">
                    <Text text="Quantidade"/>
                </Column>
                <Column>
                    <Text text="Referência"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{createdAt}"/>
                        <ObjectStatus
                         text="{path: 'type', formatter: '.formatter.movementType'}"
                         state="{path: 'type', formatter: '.formatter.movementState'}"/>
                        <Text text="{product/code}"/>
                        <Text text="{sourceLocation/code}"/>
                        <Text text="{destinationLocation/code}"/>
                        <ObjectNumber number="{quantity}"/>
                        <Text text="{reference}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
            </VBox>
        </content>
        <dependents>
            <Dialog
                id="productsDialog"
                title="Cadastro de produtos"
                contentWidth="60rem"
                stretchOnPhone="true">
                <content>
                    <VBox class="sapUiContentPadding">
                        <Toolbar>
                            <Title text="Produtos cadastrados" level="H3"/>
                            <ToolbarSpacer/>
                            <Button text="Novo produto" icon="sap-icon://add" type="Emphasized" press=".onNewProduct"/>
                        </Toolbar>
                        <Table id="productsTable" items="{/Products}" noDataText="Nenhum produto cadastrado">
                            <columns>
                                <Column><Text text="Código"/></Column>
                                <Column><Text text="Nome"/></Column>
                                <Column><Text text="Categoria"/></Column>
                                <Column><Text text="Unidade"/></Column>
