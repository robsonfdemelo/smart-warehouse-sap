_schema-version: 3.3.0
ID: smart-warehouse-sap
version: 1.0.0
description: "Smart Warehouse SAP - Sistema de Gestão de Armazém"
parameters:
  enable-parallel-deployments: true
build-parameters:
  before-all:
    - builder: custom
      commands:
        - npm ci
        - npx cds build --production
modules:
  - name: smart-warehouse-sap-srv
    type: nodejs
    path: gen/srv
    parameters:
      instances: 1
      buildpack: nodejs_buildpack
    build-parameters:
      builder: npm-ci
    provides:
      - name: srv-api # required by consumers of CAP services (e.g. approuter)
        properties:
          srv-url: ${default-url}
    requires:
      - name: smart-warehouse-sap-auth
      - name: smart-warehouse-sap-db

  - name: smart-warehouse-sap-db-deployer
    type: hdb
    path: gen/db
    parameters:
      buildpack: nodejs_buildpack
    requires:
      - name: smart-warehouse-sap-db

resources:
  - name: smart-warehouse-sap-auth
    type: org.cloudfoundry.managed-service
    parameters:
      service: xsuaa
      service-plan: application
      path: ./xs-security.json
      config:
        xsappname: smart-warehouse-sap-${org}-${space}
        tenant-mode: dedicated
        oauth2-configuration:
          credential-types:
            - "binding-secret"
            - "x509"
        role-collections:
          - name: 'Operator (smart-warehouse-sap ${org}-${space})'
            description: 'generated'
            role-template-references:
              - '$XSAPPNAME.Operator'
  - name: smart-warehouse-sap-db
    type: com.sap.xs.hdi-container
    parameters:
      service: hana
      service-plan: hdi-shared
